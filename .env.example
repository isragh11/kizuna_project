# InfluxDB (valeurs choisies par nous, pas de compte externe)
INFLUXDB_URL=http://localhost:8086
INFLUXDB_ORG=aquamind
INFLUXDB_BUCKET=farm
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=change-me-12chars
INFLUXDB_TOKEN=change-me-generate-a-random-token
# influx | sqlite  (sqlite = secours sans InfluxDB)
STORAGE_BACKEND=influx
SQLITE_PATH=data/stream.db

# MQTT
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_BASE_TOPIC=aquamind/farm1

# Ferme
FARM_LAT=34.98
FARM_LON=9.50
FARM_TZ=Africa/Tunis
JAPAN_LAT=37.90
JAPAN_LON=139.02
JAPAN_TZ=Asia/Tokyo

# Simulation
SIM_SECONDS_PER_HOUR=5
API_URL=http://localhost:8000   # API FastAPI (Phase 6) : plan du simulateur, alertes du consumer
# true = n'utilise que data/cache
OFFLINE_MODE=false

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/live
